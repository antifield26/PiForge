[Unit]
Description=PiForge workbench gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=antifield
Group=antifield
WorkingDirectory=/home/antifield/piforge
ExecStart=/usr/local/bin/node /home/antifield/piforge/packages/gateway/dist/index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=OPENCODE_URL=http://127.0.0.1:4096
Environment=DB_PATH=/home/antifield/piforge/data/wb.db
Environment=SERVICES_ALLOWLIST=/home/antifield/piforge/config/services.allowlist.json
# SESSION_SECRET must be provided via systemd drop-in or EnvironmentFile (not in git)
EnvironmentFile=-/home/antifield/piforge/gateway.env
# NoNewPrivileges cannot be set: gateway runs `sudo systemctl` for allowlisted units.
PrivateTmp=true
SupplementaryGroups=gpio

[Install]
WantedBy=multi-user.target
