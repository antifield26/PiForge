[Unit]
Description=OpenCode v2 server (localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=antifield
Group=antifield
ExecStart=/home/antifield/.opencode/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=on-failure
RestartSec=5
# API keys live only in OpenCode local config (~/.config/opencode), never here.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
